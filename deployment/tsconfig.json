{
    "compilerOptions": {
        "target": "es2025",
        "module": "esnext",
        "moduleResolution": "Node",
        "lib": ["ES2025"],
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["typelevel-study-setup.ts"]
}
